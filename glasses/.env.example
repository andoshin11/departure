# api (server/) の base URL。必須。未設定の場合はビルド/起動時にエラーになる。
# 本番の workers.dev URL が決まったら、この値と app.json の permissions[network].whitelist の
# origin を両方更新すること（build 時に whitelist との整合性を検証している）。
VITE_API_BASE_URL=http://localhost:3000

# api (server/) の全リクエストに X-API-Key として付与する値。必須。未設定の場合は
# VITE_API_BASE_URL と同様、ビルド/起動時にエラーになる。デフォルト値は無い。
# 注意: この値はビルド成果物 (.ehpk) にそのまま埋め込まれるため、配布物を解析されれば
# 取り出せる。個人利用を前提にした簡易的なアクセス制限であり、強固な秘匿は期待できない。
VITE_API_KEY=

# 開発専用（vite dev のみ有効）。"緯度,経度" を指定すると、Even App の位置情報の代わりにこの座標を使う。
# シミュレーターには位置情報 API が無いため、シミュレーターで確認するときに設定する。
# 本番ビルド（vite build）で設定されているとエラーになるため、この .env ではなく
# dev でだけ読み込まれる .env.development に書くこと。
# 例: 渋谷駅付近
# VITE_DEV_FIXED_LOCATION=35.6580,139.7016
